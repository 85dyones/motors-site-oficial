# Copie para .env.local e preencha os valores reais. Nunca commitar .env.local
# (já está no .gitignore).

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ──────────────────────────────────────────────────────────────────
# URL pública usada para montar links absolutos (feed do catálogo, etc.)
NEXT_PUBLIC_SITE_URL=

# ── Avaliações do Google (seção de reputação da home) ─────────────────────
# Lidas só no servidor, uma vez por dia. Sem elas a seção não é renderizada.
# NUNCA prefixar a chave com NEXT_PUBLIC_ — iria para o bundle do site.
# Passo a passo em docs/REPUTACAO_GOOGLE.md.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ── Cloudflare Turnstile (anti-spam nos formulários de lead) ───────────────
# NEXT_PUBLIC_* é embutido em tempo de BUILD: mudar na Vercel exige deploy novo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hosts onde o desafio pode ter sido resolvido, separados por vírgula, sem
# esquema e sem barra no fim. OBRIGATÓRIA em produção (VERCEL_ENV=production):
# sem ela a verificação recusa e grita no log. Fora de produção pode ficar
# vazia — é o que deixa Preview e o dev local usarem as chaves de teste da
# Cloudflare, cujo hostname nenhuma lista prevê.
#
# NUNCA inclua localhost nem 127.0.0.1 no valor de produção: com eles aqui,
# um token colhido numa página local valeria na produção.
# Produção hoje: motorsstore.com.br,www.motorsstore.com.br,motors-site-oficial.vercel.app
TURNSTILE_HOSTNAMES=

# Para desenvolvimento local, as chaves de teste públicas da Cloudflare:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Webhooks n8n (fallback — o painel admin permite configurar por Supabase) ─
N8N_SECRET_TOKEN=

# ── Motor do funil de leads (n8n → site) ──────────────────────────────────
# Sentido INVERSO do resto deste bloco: aqui o n8n é quem bate, em
# `POST /api/funil/alertas`, e recebe a fila de avisos de lead parado, lead sem
# dono e lead a transferir — com nome, telefone e o WhatsApp da equipe.
#
# Segredo PRÓPRIO, sem fallback para nenhum outro token. Segredo mede acesso: a
# base de leads e a base de clientes do Ciclo (CICLO_MOTOR_TOKEN) são conjuntos
# de dados diferentes, e quem tem a credencial de um não deve puxar o outro.
#
# Vazio = a rota responde 503 e o funil não avisa ninguém. É o estado honesto:
# 401 mandaria o n8n tentar outro token para sempre.
# Gere com: openssl rand -hex 32
FUNIL_MOTOR_TOKEN=
N8N_WEBHOOK_LEAD_URL=
N8N_WEBHOOK_AVALIACAO_URL=
N8N_ADMIN_WEBHOOK_URL=
NEXT_PUBLIC_N8N_WEBHOOK_LEAD_URL=
NEXT_PUBLIC_N8N_WEBHOOK_AVALIACAO_URL=

# Fila dos eventos de tracking (Contact, Search, CompleteRegistration,
# ViewContent) que hoje iriam direto ao Meta pelo /api/capi. O n8n enfileira,
# repete em caso de falha e dá visibilidade.
#
# TEM QUE SER UM WEBHOOK DIFERENTE DO DE LEAD. Contact e o evento mais
# frequente do site; se o firehose de tracking entrar no mesmo fluxo que
# entrega lead, uma enxurrada degrada o caminho que gera dinheiro.
#
# Vazia = entrega direta ao Meta, que e o comportamento anterior.
# Webhook do n8n que recebe AVISO DE FALHA e notifica alguém (WhatsApp/e-mail).
# Vazio: o aviso não existe e só o log registra — foi assim que um mês de CAPI
# parada passou sem ninguém ver (31/08 a 02/09). Ver src/lib/alertaDeFalha.ts.
N8N_WEBHOOK_ALERTA_URL=

N8N_WEBHOOK_TRACKING_URL=

# ── Upstash Redis ──────────────────────────────────────────────────────────
# Rate limit de /api/leads, /api/avaliacao e /api/capi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Meta Conversions API (server-side) ──────────────────────────────────────
# ATENÇÃO: esta variável NÃO é o que ativa o CAPI. Tanto /api/leads quanto
# /api/capi leem o Pixel ID de site_settings.company.metaPixelId (painel admin)
# e abortam antes de chamar a Graph API se aquele campo estiver vazio — então
# este valor aqui nunca chega a ser usado por esses fluxos. Preencha o campo
# "ID do Meta Pixel" no painel admin; é ele que manda.
META_PIXEL_ID=1410450786690090
# Events Manager → Configurações → Conversions API → Gerar token de acesso
# (usar um token de System User, não o de usuário pessoal).
META_CAPI_ACCESS_TOKEN=
# v26.0 verificada como ativa em 01/08/2026 (v27.0 ainda não existia). Conferir
# em developers.facebook.com/docs/graph-api/changelog antes de usar em produção,
# pode já ter mudado.
META_GRAPH_API_VERSION=v26.0
# Só em desenvolvimento, para testar em Events Manager → Testar Eventos.
# Remover em produção (deixar vazio já desativa o test_event_code).
META_CAPI_TEST_EVENT_CODE=

# ── Conexão direta ao Postgres ─────────────────────────────────────────────
# Usada por `supabase db push --db-url` e por scripts de manutenção. O app não
# lê esta variável — ele fala com o Supabase por HTTP.
#
# A senha precisa ir PERCENT-ENCODED: caracteres como % e # quebram a URI e o
# supabase CLI recusa com LegacyDbConfigParseUrlError, sem dizer o porquê.
#
# Nunca prefixar com NEXT_PUBLIC_ — isto daria acesso total ao banco a
# qualquer visitante do site.
SUPABASE_DB_URL=

# ─── Google Analytics 4 — LEITURA no painel (fallback) ────────────────────
# O site já COLETA GA4 (ver IntegrationsTracker e TRACKING_SPEC.md). Estas
# três variáveis são para o caminho de volta: o painel LER esses números e
# preencher "visitas na página" (editor de veículo) e "visitas ao catálogo"
# (visão geral). Sem elas o painel mostra "—" e explica; nunca zero.
#
# ⚠️  Desde 27/08 o caminho principal é o PAINEL: Configurações → Integração →
# "Google Analytics — leitura" grava em `site_settings` (id `ga4`), e o que
# está lá vence estas variáveis, campo a campo. Mesma forma dos webhooks do
# n8n. Preencher aqui continua funcionando e não exige nada do painel — mas
# ligar pelo painel não exige acesso à Vercel nem redeploy.
# Passo a passo do lado do Google em docs/GA4_CREDENCIAIS.md.
#
# Como obter, uma vez:
#   1. console.cloud.google.com → criar projeto (ou usar um existente)
#   2. Ativar a "Google Analytics Data API"
#   3. IAM e Admin → Contas de serviço → Criar → Gerar chave JSON
#   4. No GA4: Admin → Gerenciamento de acesso à propriedade → adicionar o
#      e-mail da conta de serviço como LEITOR (sem isso, a API dá 403 mesmo
#      com a credencial certa)
#
# ID NUMÉRICO da propriedade — não é o "G-KBL1MFN9E3".
# GA4: Admin → Detalhes da propriedade → ID da propriedade.
GA4_PROPERTY_ID=
# Campo "client_email" do JSON da conta de serviço.
GA4_CLIENT_EMAIL=
# Campo "private_key" do MESMO JSON, entre aspas e com os \n literais como
# vieram no arquivo — o código desfaz o escape ao assinar.
# Ex.: GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GA4_PRIVATE_KEY=

# ── Google Search Console (pesquisa de palavra-chave com dado próprio) ─────
# Usado por conteudo-seo/gsc.js: mostra para que buscas o site já aparece,
# em que posição e quantos clicam. É a fonte que ordena a fila de conteúdo.
#
# MESMA conta de serviço do GA4 serve para os dois — basta ativar a "Google
# Search Console API" no projeto do Google Cloud e adicionar o e-mail da
# conta como usuário em Search Console → Configurações → Usuários. Esse
# último passo é o que costuma faltar: sem ele a API responde 403 mesmo com
# a chave correta.
#
# `sc-domain:` para propriedade de domínio; a URL inteira para propriedade
# de prefixo de URL.
GSC_SITE=
GSC_CLIENT_EMAIL=
# Entre aspas, com os \n literais como vieram no JSON — igual a GA4_PRIVATE_KEY.
GSC_PRIVATE_KEY=
# Só se você usar um ID DE CLIENTE OAUTH em vez de conta de serviço. Nesse
# caso o token sai uma vez pelo OAuth Playground. Conta de serviço não precisa.
GSC_REFRESH_TOKEN=
